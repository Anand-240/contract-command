# Use the Session pooler URL from Supabase Dashboard > Connect for an IPv4 Docker host.
# URL-encode special characters in the password. Keep this file without real credentials.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DB_SSLMODE=require

# Used only with docker-compose.local.yml. Choose a long URL-safe password.
POSTGRES_PASSWORD=replace-with-long-alphanumeric-password

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_SECURE_SSL=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_TOKEN_TTL_HOURS=8

# Local showcase only. Never enable seeded demo credentials in production.
DEMO_PASSWORD=123456
VITE_DEMO_MODE=0
