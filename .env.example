# Copy to .env and replace every placeholder before starting Docker.
DB_NAME=contractcommand
DB_USER=contractcommand
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
AUTH_TOKEN_TTL_HOURS=8
DEMO_PASSWORD=123456
# Set to 1 only for a local seeded demo; this shows demo account names on the sign-in page.
VITE_DEMO_MODE=0

# Set to 1 only when the frontend is served behind HTTPS.
DJANGO_SECURE_SSL=0
